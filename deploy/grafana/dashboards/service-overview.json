{
  "uid": "petstore-overview",
  "title": "PetStore — Service Overview",
  "description": "Внешняя картина: сколько запросов, сколько из них неуспешных, как долго они идут и как нагрузка разложена по экземплярам.",
  "tags": ["petstore"],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Источник",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0,
        "regex": ""
      },
      {
        "type": "query",
        "name": "service",
        "label": "Сервис",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "definition": "label_values(petstore_requests_total, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(petstore_requests_total, service)",
          "metric": "petstore_requests_total",
          "label": "service",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Итого",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Запросов в секунду",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum(rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Доля неуспешных ответов",
      "description": "Ответы 4xx и 5xx: их отделяет метка outcome того же счётчика, отдельного метра для ошибок HTTP нет.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "100 * sum(rate(petstore_requests_total{service=~\"$service\", outcome=\"failure\"}[$__rate_interval])) / sum(rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "p95 задержки",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(petstore_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Живых экземпляров",
      "description": "Сумма up по всем job с именем petstore: статическим таргетам docker-compose или подам из service discovery. Упавший таргет даёт ноль и в сумму не идёт, поэтому цифра меньше ожидаемой означает недоступный экземпляр.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum(up{job=~\"petstore.*\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Трафик",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Запросы по сервисам",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service) (rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Успешные и неуспешные",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (outcome) (rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Коды ответов",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (status) (rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Запросы по экземплярам",
      "description": "В Kubernetes instance — имя пода, его подставляет relabeling в prometheus-k8s.yml; в docker-compose это host:port статического таргета.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service, instance) (rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · {{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Задержки",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Перцентили по сервисам",
      "description": "Считаются из гистограммы на стороне Prometheus: сервисы публикуют бакеты, а не готовые перцентили, поэтому значения по подам складываются.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "histogram_quantile(0.5, sum by (service, le) (rate(petstore_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(petstore_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(petstore_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "p95 по эндпоинтам, десять худших",
      "description": "В метке endpoint шаблон пути, а не фактический URI, поэтому идентификаторы в адресе не размножают ряды.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "topk(10, histogram_quantile(0.95, sum by (service, endpoint, le) (rate(petstore_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval]))))",
          "legendFormat": "{{service}} · {{endpoint}}"
        }
      ]
    },
    {
      "type": "table",
      "id": 23,
      "title": "Эндпоинты под нагрузкой",
      "description": "У шлюза в метке endpoint имя маршрута, а не путь: своих эндпоинтов у него нет, он проксирует.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Запросов в секунду", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "topk(20, sum by (service, endpoint) (rate(petstore_requests_total{service=~\"$service\"}[$__rate_interval])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {
              "service": "Сервис",
              "endpoint": "Эндпоинт",
              "Value": "Запросов в секунду"
            }
          }
        }
      ]
    }
  ]
}
