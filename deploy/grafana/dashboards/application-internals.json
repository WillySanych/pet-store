{
  "uid": "petstore-internals",
  "title": "PetStore — Application Internals",
  "description": "Внутренности приложений: справочные кеши, ошибки по типам, срабатывания механизмов отказоустойчивости и состояние JVM.",
  "tags": ["petstore"],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Источник",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0,
        "regex": ""
      },
      {
        "type": "query",
        "name": "service",
        "label": "Сервис",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "definition": "label_values(petstore_requests_total, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(petstore_requests_total, service)",
          "metric": "petstore_requests_total",
          "label": "service",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Справочные кеши",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Размер кешей",
      "description": "Число записей в каждом кеше справочника. Кеш перезагружается по расписанию на каждой реплике (petstore.cache.refresh-interval, по умолчанию 5 минут), поэтому ступенька на ряду означает правку самого справочника.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "petstore_cache_size{service=~\"$service\"}",
          "legendFormat": "{{service}} · {{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Доля попаданий в кеш",
      "description": "Считаются только поиски по коду: выдача всего справочника целиком не попадание и не промах, поэтому у кеша без обращений по коду здесь разрыв, а не ноль.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service, cache) (rate(petstore_cache_hits_total{service=~\"$service\"}[$__rate_interval])) / (sum by (service, cache) (rate(petstore_cache_hits_total{service=~\"$service\"}[$__rate_interval])) + sum by (service, cache) (rate(petstore_cache_misses_total{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · {{cache}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Ошибки",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Ошибки по типам",
      "description": "Тип задаётся в коде при обработке исключения, а не выводится из кода ответа: validation, not_found, unavailable, overloaded и доменные вроде compensation_failed.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (type) (rate(petstore_errors_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "table",
      "id": 12,
      "title": "Ошибки за выбранный период",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Ошибок", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service, type) (increase(petstore_errors_total{service=~\"$service\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {
              "service": "Сервис",
              "type": "Тип",
              "Value": "Ошибок"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Отказоустойчивость",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Повторы и отказы апстримов",
      "description": "Повтор считается только на UpstreamUnavailableException: остальные ошибки апстрима не повторяются. Пока ни одного повтора не было, счётчика в скрейпе нет и ряд не появится.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (upstream) (rate(petstore_upstream_retries_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{upstream}} · повторы"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{name}} · не пропущено CB"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Circuit breaker разомкнут",
      "description": "Единица означает, что автомат в этом состоянии. Закрытое состояние не показывается: интерес представляют open и half_open.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "resilience4j_circuitbreaker_state{service=~\"$service\", state=~\"open|half_open\"}",
          "legendFormat": "{{name}} · {{state}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Доля отказов в окне circuit breaker",
      "description": "Минус единица означает, что вызовов в окне ещё недостаточно для решения; такие точки отфильтрованы.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "resilience4j_circuitbreaker_failure_rate{service=~\"$service\"} >= 0",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Отказы по перегрузке",
      "description": "Запросы, отбитые 429 до входа в базу: bulkhead сервисов и ограничитель частоты шлюза пишут в один счётчик.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service, endpoint) (rate(petstore_overload_rejected_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · {{endpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 25,
      "title": "Свободные разрешения ограничителя шлюза",
      "description": "Семафор шлюза на GATEWAY_RATE_LIMIT разрешений, пополняется раз в период (по умолчанию секунда). Ноль означает, что шлюз отбивает запросы.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "petstore_ratelimit_available{service=~\"$service\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "JVM",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Heap",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*выделено.*" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}} · занято"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service) (jvm_memory_committed_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}} · выделено"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Паузы GC",
      "description": "Доля времени в паузах и самая долгая пауза за интервал. Именно эти два ряда сравниваются между G1 и ZGC.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*макс.*" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · доля времени"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "max by (service) (jvm_gc_pause_seconds_max{service=~\"$service\"})",
          "legendFormat": "{{service}} · макс. пауза"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "Потоки платформы",
      "description": "ThreadMXBean считает только потоки платформы, виртуальных здесь нет. Ровная линия под нагрузкой и означает, что запросы обслуживают виртуальные потоки.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "jvm_threads_live_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} · живые"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "jvm_threads_peak_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} · пик"
        }
      ]
    }
  ]
}
